# Stage M native Magic DRC/PEX/GDS acceptance pass.
# Placement generated by original pinned open_pdks runtime/netlist_to_layout.py.
# That generator does NOT route all transistor and power nets; an LVS match
# is mandatory. No blank cell or fabricated DRC/LVS pass is permitted.
if {![info exists ::env(STAGE_M_CELL)]} {error "STAGE_M_FAIL: missing cell"}
if {![info exists ::env(STAGE_M_SCHEMATIC)]} {error "STAGE_M_FAIL: missing schematic"}
set cell $::env(STAGE_M_CELL)
if {$cell ni {q4_thresh_det q4_inv q4_mux4 q4_half_adder}} {
    error "STAGE_M_FAIL: invalid cell name"
}
if {![file isfile $::env(STAGE_M_SCHEMATIC)] ||
    [file rootname [file tail $::env(STAGE_M_SCHEMATIC)]] ne $cell} {
    error "STAGE_M_FAIL: source input mismatch"
}
# Never create an empty cell and report a zero-error DRC.
if {![file exists "$cell.mag"]} {
    error "STAGE_M_FAIL: generated .mag cell is missing"
}
load $cell
select top cell
save $cell
drc on
drc check
set count [drc count total]
puts "STAGE_M_DRC_COUNT $cell $count"
set report [open "$cell-magic-drc.txt" w]
puts $report "STAGE_M_DRC_COUNT $cell $count"
close $report
if {![string is integer -strict $count] || $count != 0} {
    error "STAGE_M_FAIL: Magic DRC count not exactly zero"
}
extract all
ext2spice lvs
ext2spice -o "$cell-lvs.spice"
ext2spice cthresh 0
ext2spice rthresh 0
ext2spice -o "$cell-pex.spice"
gds write $cell
puts "STAGE_M_DRC_ZERO_PEX_GENERATED_NOT_LVS_PROVEN $cell"
quit -noprompt
