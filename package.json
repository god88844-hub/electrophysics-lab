{
  "name": "invention-lab",
  "version": "1.0.0",
  "description": "Invention Lab — a modular multi-domain simulation platform (digital twin) with logic, chip, CPU, AI-accelerator and quantum labs.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "bench:ngspice": "node js/bench/run.mjs --suite ngspice",
    "bench:quantum": "node js/bench/run.mjs --suite quantum",
    "bench": "node js/bench/run.mjs --suite all",
    "lab:3d": "npm run dev --prefix apps/electrophysics-3d"
  }
}
